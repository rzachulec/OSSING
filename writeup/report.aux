\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Czas działania heurystyki (linie ciągłe) i solvera CPLEX (linie przerywane) w funkcji liczby łączy $L$, dla czterech rodzin danych wejściowych. Dla instancji o tej samej wartości $L$ czasy uśredniono. CPLEX nie zwrócił rozwiązania dla największych instancji ($L=18$), stąd brak odpowiednich punktów.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:time-compare}{{2}{10}{Czas działania heurystyki (linie ciągłe) i solvera CPLEX (linie przerywane) w funkcji liczby łączy $L$, dla czterech rodzin danych wejściowych. Dla instancji o tej samej wartości $L$ czasy uśredniono. CPLEX nie zwrócił rozwiązania dla największych instancji ($L=18$), stąd brak odpowiednich punktów}{figure.2}{}}
